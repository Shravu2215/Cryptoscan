# Copy this to .env and fill in real values. Never commit .env itself.

# SQLite connection string
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server (default port 3000 to match frontend expectation)
PORT=3000

# Upload limits
MAX_UPLOAD_SIZE_MB=50
MAX_EXTRACTED_SIZE_MB=250

# Blockchain configuration
CHAIN_MODE=public
PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
PRIVATE_KEY=

