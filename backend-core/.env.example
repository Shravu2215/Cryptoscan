# Copy this to .env and fill in real values. Never commit .env itself.

# SQLite connection string
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server (default port 3000 to match frontend expectation)
PORT=3000

# Upload limits
MAX_UPLOAD_SIZE_MB=50

# Blockchain configuration
RPC_URL=http://127.0.0.1:8545
PRIVATE_KEY=

