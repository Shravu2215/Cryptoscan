# Copy this to .env and fill in real values. Never commit .env itself.

# SQLite connection string
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Required: base64-encoded 32-byte AES-256-GCM key.
DATA_ENCRYPTION_KEY=
REDIS_URL=redis://redis:6379

# Server (default port 3000 to match frontend expectation)
PORT=3000

# Upload limits
MAX_UPLOAD_SIZE_MB=50
MAX_EXTRACTED_SIZE_MB=250

# Blockchain configuration
RPC_URL=http://127.0.0.1:8545
PRIVATE_KEY=

# Required in production: comma-separated list of allowed frontend origins
# for CORS (e.g. https://app.example.com,https://admin.example.com).
ALLOWED_ORIGINS=

# NODE_ENV=production enables strict CORS, secure cookies, and fail-fast
# validation of the vars above.
NODE_ENV=development

# Key management for the classical (ECDSA/secp256k1) anchoring signature.
# "env" (default) reads PRIVATE_KEY directly — fine for local/dev only.
# "aws-kms" delegates signing to an asymmetric ECC_SECG_P256K1 KMS key;
# set AWS_KMS_KEY_ID/AWS_REGION and standard AWS credentials, and install
# the optional dependency @aws-sdk/client-kms.
KMS_PROVIDER=env
AWS_KMS_KEY_ID=
AWS_REGION=

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
# Base URL the browser is redirected back to after OAuth (no trailing slash),
# e.g. https://app.example.com or http://localhost:3000 in dev.
FRONTEND_URL=http://localhost:3000

