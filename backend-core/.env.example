# Copy this to .env and fill in real values. Never commit .env itself.

# Postgres connection string
# Windows note: if you hit the DATABASE_URL parsing bug, wrap the whole value
# in quotes and URL-encode any special characters in the password.
DATABASE_URL="postgresql://postgres:password@localhost:5432/cryptoscan?schema=public"

# JWT
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000

# Upload limits
MAX_UPLOAD_SIZE_MB=50
