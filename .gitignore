*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Environment files & secrets (Strictly ignored)
.env
.env.*
!.env.example
*.env

# SQLite databases & logs
*.db
*.db-journal
*.sqlite
*.sqlite3
backend-core/prisma/*.db
backend-core/prisma/*.db-journal

# Uploads & temporary scan files
