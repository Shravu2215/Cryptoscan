!backend-core/uploads/.gitkeep
scanner/out.json
scratch/

# Build outputs & caches
dist/
build/
.next/
out/
coverage/
.nyc_output/

# Hardhat & Smart contract artifacts
blockchain-module/artifacts/
blockchain-module/cache/
blockchain-module/typechain/
blockchain-module/typechain-types/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & OS artifacts
.vscode/
.idea/
.DS_Store
Thumbs.db
