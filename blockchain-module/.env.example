# ==============================================================================
# CryptoScan Blockchain Module - Environment Configuration Template
# All secrets and private credentials MUST remain in .env (never committed).
# ==============================================================================

# --- Network & Chain Routing ---
# Execution mode: "permissioned" (local/private EVM) or "public" (Sepolia/public testnet)
CHAIN_MODE=public

# Permissioned / Local Network Configuration

PERMISSIONED_RPC_URL=http://127.0.0.1:8545
PERMISSIONED_CONTRACT_ADDRESS=

# Public Network (Sepolia Testnet) Configuration
PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
PUBLIC_CONTRACT_ADDRESS=

# --- Wallet & Signing Credentials ---
# Throwaway testnet or local wallet private key (NEVER a mainnet wallet)
PRIVATE_KEY=

# Block explorer verification key (optional)
ETHERSCAN_API_KEY=

# --- Organization & Scanner Metadata ---
ORG_ID=default-org
SCANNER_VERSION=1.0.0

# --- IPFS & Decentralized Storage (Phase 4 / 5) ---
PINATA_JWT=
IPFS_API_URL=https://api.pinata.cloud
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

