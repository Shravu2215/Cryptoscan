# CryptoScan Blockchain Module — Environment Variables
# Copy to .env in this directory for standalone hardhat/anchor commands.

# --- Network & Chain Routing ---
# Execution mode: "permissioned" (local/private EVM) or "public" (Sepolia/public testnet)
CHAIN_MODE=permissioned

# Permissioned / Local Network Configuration
RPC_URL=http://127.0.0.1:8545
PERMISSIONED_RPC_URL=http://127.0.0.1:8545
PERMISSIONED_CONTRACT_ADDRESS=

# Public / Sepolia Network Configuration
PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
PUBLIC_CONTRACT_ADDRESS=

# Account Private Key (hex string with 0x prefix)
# Used for contract deployment and as default local KMS key
PRIVATE_KEY=
